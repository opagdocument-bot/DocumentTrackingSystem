# Copy this file to .env and fill in real values there. .env is gitignored —
# .env.example is the only one of the two that gets committed.
#
# Vite bundles anything prefixed VITE_ straight into the browser JS, so only
# ever put the PUBLIC Supabase values here. The anon key is meant to be
# public — every request it makes is still checked against Row Level
# Security on the server. The service role key (from backend/.env) must never
# appear in this file or anywhere else client-side.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
