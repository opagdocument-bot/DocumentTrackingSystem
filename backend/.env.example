# Copy this file to .env and fill in real values there. .env is gitignored —
# .env.example is the only one of the two that gets committed.
#
# EVERYTHING in this file is a secret. None of it may ever be pasted into
# app/ or mobile/, embedded in client code, or shown in a screenshot. These
# are used only for server-side work — applying migrations, running Edge
# Functions, and writing proof photos to Google Drive.

# From your Supabase project's Settings -> API.
SUPABASE_PROJECT_REF=
SUPABASE_URL=
# service_role key — bypasses every Row Level Security rule. Full read/write
# to everything, for every table. Treat this like a database root password.
SUPABASE_SERVICE_ROLE_KEY=

# From Account Settings -> Access Tokens (supabase.com), used only to let the
# Supabase CLI push migrations from this machine.
SUPABASE_ACCESS_TOKEN=
# Settings -> Database -> the password you set when the project was created.
SUPABASE_DB_PASSWORD=

# Google Cloud service account with Drive API access (see the setup steps
# when this is reached) — the whole downloaded JSON key file's contents,
# not just a snippet of it.
GOOGLE_SERVICE_ACCOUNT_JSON=
# The Drive folder (shared with that service account) proof photos are
# written into.
GOOGLE_DRIVE_FOLDER_ID=
