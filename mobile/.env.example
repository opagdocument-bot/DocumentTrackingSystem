# Copy this file to .env and fill in real values there. .env is gitignored —
# .env.example is the only one of the two that gets committed.
#
# Expo bundles anything prefixed EXPO_PUBLIC_ straight into the app, so only
# ever put the PUBLIC Supabase values here — same anon key as app/.env.
# The service role key must never appear in this file.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
