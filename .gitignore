# Secrets — real values live only in these files, never committed.
# See .env.example in app/, mobile/ and backend/ for what belongs in each.
.env
.env.*
!.env.example
*service-account*.json
*.pem
*.key

# Dependencies
node_modules/
**/node_modules/

# Build output
app/dist/
mobile/dist/
mobile/web-build/
*.tsbuildinfo

# Expo / React Native
mobile/.expo/
mobile/.expo-shared/
*.jks
*.p8
*.p12
*.mobileprovision
*.orig.*

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Supabase CLI local state
backend/supabase/.branches/
backend/supabase/.temp/
